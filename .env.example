# ==============================================================================
# Alya Weather - Environment Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="Alya Weather"
APP_ENV="development"
APP_PORT=8000
APP_HOST="0.0.0.0"
DEBUG=true

# Frontend Configuration
VITE_APP_TITLE="Alya Weather"
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_DEFAULT_LOCALE="en-IN"
VITE_DEFAULT_CITY="New Delhi"

# Data Provider Configurations (India & Global)
# Open-Meteo Weather & Air Quality API (No key required for non-commercial tier)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1"

# Central Pollution Control Board (CPCB) / National AQI Stubs
INDIA_AQI_API_KEY=""
INDIA_AQI_BASE_URL=""

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"
