# ==============================================================================
# Tamil Nadu Climate & Forecast Intelligence Platform — Production .gitignore
# Excludes environment secrets, SQLite databases, large datasets, model binaries,
# Python virtual environments, and Next.js build caches.
# ==============================================================================

# 1. Environment Secrets & Configs
.env
.env.*
!.env.example
!.env.local.example
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local

# 2. SQLite Databases (Preserved strictly on persistent volumes, e.g. /var/data/)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite*
/var/data/

# 3. Datasets (Parquet & Large CSVs)
*.parquet
backend/data/*.parquet
backend/data/processed/
backend/data/raw/
backend/data/reports/*.pdf
backend/data/reports/*.csv
/datasets/

# 4. Machine Learning Model Artifacts & Weights (Stored in persistent storage)
*.joblib
*.pkl
*.bin
*.pt
*.onnx
backend/models/*.joblib
backend/models/saved_models/
/models/

# 5. Python Environments & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Pytest & Test Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# 6. Next.js & Node.js Artifacts (Vercel Build Cache)
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.vercel
frontend/.vercel

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 7. Operating System & Editor Metadata
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
